# Connection string do Neon (Dashboard do Neon → Connect → copie a "Pooled connection")
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Quem pode editar: usuario:senha separados por vírgula (não use vírgula na senha)
ADMIN_USERS=lucas:troque-esta-senha,tulio:troque-esta-senha

# Texto aleatório longo (mínimo 32 caracteres) usado para assinar o login
SESSION_SECRET=gere-um-texto-aleatorio-com-pelo-menos-32-caracteres
